# =============================================================================
# Environment template — copy to `.env` and fill in real values.
# `.env` is in `.gitignore` and MUST NEVER be committed.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Clinic Management System"
APP_ENV=local              # local | staging | production
APP_KEY=                   # run `php artisan key:generate` after `cp .env.example .env`
APP_DEBUG=false            # MUST be false in staging / production
APP_URL=http://localhost   # public URL; required for signed URLs & emails

# Timezone — use Asia/Phnom_Penh for Cambodia deployments
APP_TIMEZONE=UTC

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info             # debug only in `local`; info/warning in production

# ─── Database (MySQL 8.x or MariaDB 10.6+) ───────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clinic
DB_USERNAME=clinic_user
DB_PASSWORD=               # required; do not leave blank in non-local envs

# ─── Cache / Queue / Session ─────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file          # use `redis` in production
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync      # use `redis` in production
SESSION_DRIVER=file        # use `redis` in production
SESSION_LIFETIME=120       # minutes

# ─── Redis (optional) ────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailhog          # `smtp.gmail.com`, `smtp.sendgrid.net`, ... in prod
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null       # `tls` for port 587 in production
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Object storage (S3-compatible, optional) ────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Pusher / Broadcasting (optional) ────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite-exposed Pusher vars (kept identical to PUSHER_* above)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
